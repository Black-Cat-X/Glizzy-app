{
  "name": "Glizzy · Reporte diario",
  "short_name": "Glizzy",
  "description": "Lee la foto del QR del cierre de caja y arma el renglón para Excel",
  "lang": "es",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1D1712",
  "theme_color": "#1D1712",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [ { "name": "foto", "accept": ["image/*"] } ]
    }
  }
}
